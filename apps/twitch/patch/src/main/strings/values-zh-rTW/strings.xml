<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="block_embedded_ads">封鎖內嵌廣告</string>
    <string name="block_embedded_ads_description">透過第三方代理伺服器載入無廣告的直播，該代理伺服器看得到你的 IP 位址和你觀看的頻道。</string>
    <string name="block_video_ads">封鎖影片廣告</string>
    <string name="block_video_ads_description">封鎖 Twitch 自行請求的廣告，但直播中的廣告需要「封鎖內嵌廣告」。</string>
    <string name="ignore_ad_events">忽略廣告事件</string>
    <string name="ignore_ad_events_description">忽略 Twitch 在直播期間宣告的廣告時段和廣告追蹤。</string>
    <string name="settings_entry">Reseam 設定入口</string>
    <string name="settings_entry_description">在 Twitch 設定的「帳號」上方新增 Reseam 設定。</string>
    <string name="enable_debug_mode">啟用偵錯模式</string>
    <string name="enable_debug_mode_description">顯示 Twitch 的員工工具，例如偵錯選單和影片偵錯面板。</string>
    <string name="fix_login_crash">修正登入當機</string>
    <string name="fix_login_crash_description">防止 Twitch 在你登入後立即當機。</string>
    <string name="startup_tab">啟動分頁</string>
    <string name="startup_tab_description">讓 Twitch 在「瀏覽」或「個人檔案」開啟，並解鎖「預設首頁」設定。</string>
    <string name="hide_create_button">隱藏建立按鈕</string>
    <string name="hide_create_button_description">隱藏底部列和側邊欄中的「建立」按鈕。</string>
    <string name="hide_stories_shelf">隱藏限時動態列</string>
    <string name="hide_stories_shelf_description">隱藏「首頁」頂端的一排限時動態。</string>
    <string name="block_analytics">封鎖分析</string>
    <string name="block_analytics_description">阻止 comScore、Nielsen、Sentry、Crashlytics、Sprig 和 Branch。</string>
    <string name="disable_update_prompts">停用更新提示</string>
    <string name="disable_update_prompts_description">不再顯示更新提示。</string>
    <string name="auto_claim_rewards">自動領取獎勵</string>
    <string name="auto_claim_rewards_description">觀看時在背景領取頻道點數獎勵。</string>
    <string name="clean_share_links">清理分享連結</string>
    <string name="clean_share_links_description">移除你分享和複製的連結中的追蹤參數。</string>
    <string name="default_video_quality">預設影片畫質</string>
    <string name="default_video_quality_description">以你選擇的畫質開始播放實況和影片，預設為「原始畫質」。</string>
    <string name="refresh_stream">重新整理實況</string>
    <string name="refresh_stream_description">像 Twitch 的「重試」按鈕一樣重新載入卡住的實況。</string>
    <string name="show_vod_chapters">顯示 VOD 章節</string>
    <string name="show_vod_chapters_description">在 VOD 播放器中新增「章節」按鈕，列出實況的分類變更，並跳到你選擇的位置。</string>
    <string name="hide_subscription_upsells">隱藏訂閱推廣</string>
    <string name="hide_subscription_upsells_description">隱藏「訂閱」和「贈送訂閱」按鈕以及 Turbo 推廣。</string>
    <string name="hide_player_overlay_buttons">隱藏播放器上的按鈕</string>
    <string name="hide_player_overlay_buttons_description">隱藏播放器上的剪輯、投放、分享和旋轉螢幕按鈕。</string>
    <string name="hide_leaderboards">隱藏排行榜</string>
    <string name="hide_leaderboards_description">隱藏聊天室上方的贈送、加油和剪輯排行榜。</string>
    <string name="hide_bits_buttons">隱藏 Bits 按鈕</string>
    <string name="hide_bits_buttons_description">隱藏聊天輸入框旁的 Bits 按鈕和橫向聊天室中的加油按鈕。</string>
    <string name="hide_channel_points_buttons">隱藏頻道點數按鈕</string>
    <string name="hide_channel_points_buttons_description">隱藏聊天輸入框旁和橫向聊天室中的頻道點數按鈕。</string>
    <string name="hide_community_highlights">隱藏社群精彩時刻</string>
    <string name="hide_community_highlights_description">隱藏聊天室上方的釘選訊息、熱力列車、投票、預測和其他精彩時刻。</string>
    <string name="hide_chat_badges">隱藏聊天徽章</string>
    <string name="hide_chat_badges_description">隱藏聊天室中名稱旁的徽章。</string>
    <string name="hide_welcome_message">隱藏歡迎訊息</string>
    <string name="hide_welcome_message_description">隱藏聊天室連線時顯示的「歡迎來到聊天室！」這一行。</string>
    <string name="keep_deleted_messages">保留已刪除的訊息</string>
    <string name="keep_deleted_messages_description">以紅色背景顯示被管理員刪除的訊息內容，並標示「已刪除」、「禁言」或「已封鎖」。</string>
    <string name="keep_chat_after_a_clear">清除後保留聊天</string>
    <string name="keep_chat_after_a_clear_description">管理員清除聊天室時保留其中的訊息，且不顯示 Twitch 的「聊天室已被管理員清除」這一行。</string>
    <string name="hide_blocked_messages">隱藏已封鎖的訊息</string>
    <string name="hide_blocked_messages_description">在你管理的頻道中，移除 Twitch 為已封鎖使用者的訊息顯示的預留位置。</string>
    <string name="shrink_giant_emotes">縮小巨型表情符號</string>
    <string name="shrink_giant_emotes_description">以正常大小顯示用 Bits 放大的表情符號。</string>
    <string name="hide_sub_and_gift_notices">隱藏訂閱和贈送通知</string>
    <string name="hide_sub_and_gift_notices_description">隱藏訂閱、續訂和贈送訂閱的聊天行。</string>
    <string name="hide_shared_chat_from_other_channels">隱藏其他頻道的共享聊天</string>
    <string name="hide_shared_chat_from_other_channels_description">在共享聊天中隱藏其他頻道的訊息和通知。</string>
    <string name="hide_watch_streaks">隱藏連續觀看紀錄</string>
    <string name="hide_watch_streaks_description">隱藏聊天室、頻道點數選單、「追隨中」分頁、「首頁」和頻道頁面中的連續觀看紀錄。</string>
    <string name="dont_follow_raids">不跟隨揪團</string>
    <string name="dont_follow_raids_description">頻道揪團到其他頻道時讓你留在目前的頻道。</string>
    <string name="hide_viewer_count">隱藏觀眾人數</string>
    <string name="hide_viewer_count_description">隱藏播放器上的觀眾人數。</string>
    <string name="hide_content_classification_label">隱藏內容分級標籤</string>
    <string name="hide_content_classification_label_description">隱藏播放器頂端類似「適合特定觀眾」的標籤。</string>
    <string name="skip_mature_content_warnings">略過成人內容警告</string>
    <string name="skip_mature_content_warnings_description">直接播放標示為適合成人觀眾的實況和影片，不顯示警告畫面。</string>
</resources>
