<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="block_embedded_ads">삽입 광고 차단</string>
    <string name="block_embedded_ads_description">광고 없는 라이브 방송을 서드파티 프록시를 통해 불러옵니다. 프록시는 내 IP 주소와 시청하는 채널을 볼 수 있습니다.</string>
    <string name="block_video_ads">동영상 광고 차단</string>
    <string name="block_video_ads_description">Twitch가 직접 요청하는 광고를 차단하지만, 라이브 방송에 포함된 광고는 \'삽입 광고 차단\'이 필요합니다.</string>
    <string name="ignore_ad_events">광고 이벤트 무시</string>
    <string name="ignore_ad_events_description">방송 중 Twitch가 알리는 광고 시간과 광고 추적을 무시합니다.</string>
    <string name="settings_entry">Reseam 설정 항목</string>
    <string name="settings_entry_description">Twitch 설정의 계정 위에 Reseam 설정을 추가합니다.</string>
    <string name="enable_debug_mode">디버그 모드 사용</string>
    <string name="enable_debug_mode_description">디버그 메뉴, 동영상 디버그 패널 같은 Twitch 직원 도구를 표시합니다.</string>
    <string name="fix_login_crash">로그인 비정상 종료 수정</string>
    <string name="fix_login_crash_description">로그인 직후 Twitch가 비정상 종료되지 않게 합니다.</string>
    <string name="startup_tab">시작 탭</string>
    <string name="startup_tab_description">Twitch를 탐색 또는 프로필에서 열고, 기본 홈 페이지 설정을 잠금 해제합니다.</string>
    <string name="hide_create_button">만들기 버튼 숨기기</string>
    <string name="hide_create_button_description">하단 바와 사이드 레일의 만들기 버튼을 숨깁니다.</string>
    <string name="hide_stories_shelf">스토리 선반 숨기기</string>
    <string name="hide_stories_shelf_description">홈 상단의 스토리 줄을 숨깁니다.</string>
    <string name="block_analytics">분석 차단</string>
    <string name="block_analytics_description">comScore, Nielsen, Sentry, Crashlytics, Sprig, Branch를 중지합니다.</string>
    <string name="disable_update_prompts">업데이트 안내 사용 중지</string>
    <string name="disable_update_prompts_description">업데이트 안내를 표시하지 않습니다.</string>
    <string name="auto_claim_rewards">보상 자동 받기</string>
    <string name="auto_claim_rewards_description">시청하는 동안 보너스 채널 포인트를 백그라운드에서 받습니다.</string>
    <string name="clean_share_links">공유 링크 정리</string>
    <string name="clean_share_links_description">공유하고 복사하는 링크에서 추적 정보를 제거합니다.</string>
    <string name="default_video_quality">기본 동영상 화질</string>
    <string name="default_video_quality_description">방송과 동영상을 선택한 화질로 시작합니다. 기본값은 원본입니다.</string>
    <string name="refresh_stream">방송 새로고침</string>
    <string name="refresh_stream_description">멈춘 방송을 Twitch의 다시 시도 버튼처럼 다시 불러옵니다.</string>
    <string name="show_vod_chapters">VOD 챕터 표시</string>
    <string name="show_vod_chapters_description">VOD 플레이어에 방송의 카테고리 변경을 보여 주고 선택한 곳으로 이동하는 챕터 버튼을 추가합니다.</string>
    <string name="hide_subscription_upsells">구독 권유 숨기기</string>
    <string name="hide_subscription_upsells_description">구독 및 구독 선물 버튼과 Turbo 제안을 숨깁니다.</string>
    <string name="hide_player_overlay_buttons">플레이어 위 버튼 숨기기</string>
    <string name="hide_player_overlay_buttons_description">플레이어의 클립, 전송, 공유, 화면 회전 버튼을 숨깁니다.</string>
    <string name="hide_leaderboards">리더보드 숨기기</string>
    <string name="hide_leaderboards_description">채팅 위의 선물, 응원, 클립 리더보드를 숨깁니다.</string>
    <string name="hide_bits_buttons">Bits 버튼 숨기기</string>
    <string name="hide_bits_buttons_description">채팅 입력란 옆의 Bits 버튼과 가로 채팅의 응원 버튼을 숨깁니다.</string>
    <string name="hide_channel_points_buttons">채널 포인트 버튼 숨기기</string>
    <string name="hide_channel_points_buttons_description">채팅 입력란 옆과 가로 채팅의 채널 포인트 버튼을 숨깁니다.</string>
    <string name="hide_community_highlights">커뮤니티 하이라이트 숨기기</string>
    <string name="hide_community_highlights_description">채팅 위의 고정 메시지, 하이프 트레인, 투표, 예측 및 기타 하이라이트를 숨깁니다.</string>
    <string name="hide_chat_badges">채팅 배지 숨기기</string>
    <string name="hide_chat_badges_description">채팅에서 이름 옆의 배지를 숨깁니다.</string>
    <string name="hide_welcome_message">환영 메시지 숨기기</string>
    <string name="hide_welcome_message_description">채팅이 연결될 때 표시하는 \'채팅방에 오신 것을 환영합니다!\' 줄을 숨깁니다.</string>
    <string name="keep_deleted_messages">삭제된 메시지 유지</string>
    <string name="keep_deleted_messages_description">모더레이터가 삭제한 메시지의 내용을 빨간 배경에 \'삭제됨\', \'타임아웃\', \'차단됨\' 라벨과 함께 표시합니다.</string>
    <string name="keep_chat_after_a_clear">채팅 지우기 후에도 유지</string>
    <string name="keep_chat_after_a_clear_description">모더레이터가 채팅을 지워도 메시지를 유지하며, Twitch의 \'모더레이터가 채팅을 지웠습니다\' 줄은 표시하지 않습니다.</string>
    <string name="hide_blocked_messages">차단된 메시지 숨기기</string>
    <string name="hide_blocked_messages_description">내가 관리하는 채널에서 차단된 사용자의 메시지 대신 Twitch가 표시하는 자리 표시자를 제거합니다.</string>
    <string name="shrink_giant_emotes">거대한 이모티콘 축소</string>
    <string name="shrink_giant_emotes_description">Bits로 커진 이모티콘을 원래 크기로 표시합니다.</string>
    <string name="hide_sub_and_gift_notices">구독 및 선물 알림 숨기기</string>
    <string name="hide_sub_and_gift_notices_description">구독, 재구독, 구독 선물에 대한 채팅 줄을 숨깁니다.</string>
    <string name="hide_shared_chat_from_other_channels">다른 채널의 공유 채팅 숨기기</string>
    <string name="hide_shared_chat_from_other_channels_description">공유 채팅에서 다른 채널의 메시지와 알림을 숨깁니다.</string>
    <string name="hide_watch_streaks">시청 연속 기록 숨기기</string>
    <string name="hide_watch_streaks_description">채팅, 채널 포인트 메뉴, 팔로잉 탭, 홈, 채널 페이지에서 시청 연속 기록을 숨깁니다.</string>
    <string name="dont_follow_raids">레이드 따라가지 않기</string>
    <string name="dont_follow_raids_description">채널이 다른 채널로 레이드해도 현재 채널에 머뭅니다.</string>
    <string name="hide_viewer_count">시청자 수 숨기기</string>
    <string name="hide_viewer_count_description">플레이어의 시청자 수를 숨깁니다.</string>
    <string name="hide_content_classification_label">콘텐츠 분류 라벨 숨기기</string>
    <string name="hide_content_classification_label_description">플레이어 상단의 \'특정 시청자 대상\' 같은 라벨을 숨깁니다.</string>
    <string name="skip_mature_content_warnings">성인용 콘텐츠 경고 건너뛰기</string>
    <string name="skip_mature_content_warnings_description">성인용으로 표시된 방송과 동영상을 경고 화면 없이 시작합니다.</string>
</resources>
