<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="block_embedded_ads">阻止嵌入式广告</string>
    <string name="block_embedded_ads_description">通过第三方代理加载无广告的直播，该代理能看到你的 IP 地址和你观看的频道。</string>
    <string name="block_video_ads">阻止视频广告</string>
    <string name="block_video_ads_description">阻止 Twitch 自己请求的广告，但直播中的广告需要“阻止嵌入式广告”。</string>
    <string name="ignore_ad_events">忽略广告事件</string>
    <string name="ignore_ad_events_description">忽略 Twitch 在直播期间宣布的广告时段和广告跟踪。</string>
    <string name="settings_entry">Reseam 设置入口</string>
    <string name="settings_entry_description">在 Twitch 设置中的“帐户”上方添加 Reseam 设置。</string>
    <string name="enable_debug_mode">启用调试模式</string>
    <string name="enable_debug_mode_description">显示 Twitch 的员工工具，例如调试菜单和视频调试面板。</string>
    <string name="fix_login_crash">修复登录崩溃</string>
    <string name="fix_login_crash_description">防止 Twitch 在你登录后立即崩溃。</string>
    <string name="startup_tab">启动标签页</string>
    <string name="startup_tab_description">让 Twitch 在“浏览”或“个人资料”上打开，并解锁“默认主页”设置。</string>
    <string name="hide_create_button">隐藏创建按钮</string>
    <string name="hide_create_button_description">隐藏底栏和侧边栏中的“创建”按钮。</string>
    <string name="hide_stories_shelf">隐藏快拍栏</string>
    <string name="hide_stories_shelf_description">隐藏“首页”顶部的一排快拍。</string>
    <string name="block_analytics">阻止分析</string>
    <string name="block_analytics_description">阻止 comScore、Nielsen、Sentry、Crashlytics、Sprig 和 Branch。</string>
    <string name="disable_update_prompts">停用更新提示</string>
    <string name="disable_update_prompts_description">不再显示更新提示。</string>
    <string name="auto_claim_rewards">自动领取奖励</string>
    <string name="auto_claim_rewards_description">观看时在后台领取频道积分奖励。</string>
    <string name="clean_share_links">清理分享链接</string>
    <string name="clean_share_links_description">移除你分享和复制的链接中的跟踪参数。</string>
    <string name="default_video_quality">默认视频画质</string>
    <string name="default_video_quality_description">以你选择的画质开始播放直播和视频，默认为“源画质”。</string>
    <string name="refresh_stream">刷新直播</string>
    <string name="refresh_stream_description">像 Twitch 的“重试”按钮一样重新加载卡住的直播。</string>
    <string name="show_vod_chapters">显示 VOD 章节</string>
    <string name="show_vod_chapters_description">在 VOD 播放器中添加“章节”按钮，列出直播的分类变化，并跳转到你选择的位置。</string>
    <string name="hide_subscription_upsells">隐藏订阅推广</string>
    <string name="hide_subscription_upsells_description">隐藏“订阅”和“赠送订阅”按钮以及 Turbo 推广。</string>
    <string name="hide_player_overlay_buttons">隐藏播放器上的按钮</string>
    <string name="hide_player_overlay_buttons_description">隐藏播放器上的剪辑、投放、分享和旋转屏幕按钮。</string>
    <string name="hide_leaderboards">隐藏排行榜</string>
    <string name="hide_leaderboards_description">隐藏聊天上方的赠送、欢呼和剪辑排行榜。</string>
    <string name="hide_bits_buttons">隐藏 Bits 按钮</string>
    <string name="hide_bits_buttons_description">隐藏聊天输入框旁的 Bits 按钮和横屏聊天中的欢呼按钮。</string>
    <string name="hide_channel_points_buttons">隐藏频道积分按钮</string>
    <string name="hide_channel_points_buttons_description">隐藏聊天输入框旁和横屏聊天中的频道积分按钮。</string>
    <string name="hide_community_highlights">隐藏社区亮点</string>
    <string name="hide_community_highlights_description">隐藏聊天上方的置顶消息、炒作列车、投票、预测和其他亮点。</string>
    <string name="hide_chat_badges">隐藏聊天徽章</string>
    <string name="hide_chat_badges_description">隐藏聊天中名字旁边的徽章。</string>
    <string name="hide_welcome_message">隐藏欢迎消息</string>
    <string name="hide_welcome_message_description">隐藏聊天连接时显示的“欢迎来到聊天室！”这一行。</string>
    <string name="keep_deleted_messages">保留已删除的消息</string>
    <string name="keep_deleted_messages_description">以红色背景显示被管理员删除的消息内容，并标注“已删除”“禁言”或“已封禁”。</string>
    <string name="keep_chat_after_a_clear">清空后保留聊天</string>
    <string name="keep_chat_after_a_clear_description">管理员清空聊天时保留其中的消息，且不显示 Twitch 的“聊天已被管理员清空”这一行。</string>
    <string name="hide_blocked_messages">隐藏已屏蔽的消息</string>
    <string name="hide_blocked_messages_description">在你管理的频道中，移除 Twitch 为已屏蔽用户的消息显示的占位内容。</string>
    <string name="shrink_giant_emotes">缩小巨型表情</string>
    <string name="shrink_giant_emotes_description">以正常大小显示用 Bits 放大的表情。</string>
    <string name="hide_sub_and_gift_notices">隐藏订阅和赠送通知</string>
    <string name="hide_sub_and_gift_notices_description">隐藏订阅、续订和赠送订阅的聊天行。</string>
    <string name="hide_shared_chat_from_other_channels">隐藏来自其他频道的共享聊天</string>
    <string name="hide_shared_chat_from_other_channels_description">在共享聊天中隐藏其他频道的消息和通知。</string>
    <string name="hide_watch_streaks">隐藏连续观看记录</string>
    <string name="hide_watch_streaks_description">隐藏聊天、频道积分菜单、“关注”标签、“首页”和频道页面中的连续观看记录。</string>
    <string name="dont_follow_raids">不跟随突袭</string>
    <string name="dont_follow_raids_description">频道突袭其他频道时让你留在当前频道。</string>
    <string name="hide_viewer_count">隐藏观众人数</string>
    <string name="hide_viewer_count_description">隐藏播放器上的观众人数。</string>
    <string name="hide_content_classification_label">隐藏内容分级标签</string>
    <string name="hide_content_classification_label_description">隐藏播放器顶部类似“面向特定受众”的标签。</string>
    <string name="skip_mature_content_warnings">跳过成人内容警告</string>
    <string name="skip_mature_content_warnings_description">直接播放标记为面向成人观众的直播和视频，不显示警告页面。</string>
</resources>
