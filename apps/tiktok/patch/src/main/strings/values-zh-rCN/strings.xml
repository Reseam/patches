<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="fix_login">修复登录</string>
    <string name="fix_login_description">让使用 Google 和 Facebook 登录可以正常工作。</string>
    <string name="hide_ads">隐藏广告</string>
    <string name="hide_ads_description">隐藏广告和推广帖子，以及启动时的全屏广告。</string>
    <string name="flag_overrides">功能开关覆盖</string>
    <string name="flag_overrides_description">按键名设置 TikTok 的服务器设置和实验。</string>
    <string name="settings_gear">Reseam 设置按钮</string>
    <string name="settings_gear_description">在“我”标签页添加一个打开 Reseam 设置的按钮。</string>
    <string name="downloads">下载</string>
    <string name="downloads_description">保存没有水印的视频和照片，即使作者关闭了保存功能。</string>
    <string name="filter_feed">过滤推荐流</string>
    <string name="filter_feed_description">按帐户、话题标签、关键词、地区、播放量、点赞数、发布时间或时长隐藏帖子。</string>
    <string name="hide_feed_content">隐藏推荐流内容</string>
    <string name="hide_feed_content_description">隐藏选定类型的帖子，例如直播、商店或 AI 生成的帖子。</string>
    <string name="inbox">收件箱</string>
    <string name="inbox_description">隐藏收件箱中选定的版块，例如快拍和推荐帐户。</string>
    <string name="always_show_seek_bar">始终显示进度条</string>
    <string name="always_show_seek_bar_description">在每个视频上都显示进度条，而不只是长视频。</string>
    <string name="disable_like_long_press">停用长按点赞</string>
    <string name="disable_like_long_press_description">长按点赞时不再打开表情回应选项。</string>
    <string name="hide_comment_animations">隐藏评论动画</string>
    <string name="hide_comment_animations_description">阻止评论中某些词语触发的全屏特效。</string>
    <string name="hide_comment_suggestions">隐藏评论建议</string>
    <string name="hide_comment_suggestions_description">输入评论时隐藏贴纸和表情建议。</string>
    <string name="hide_follow_button">隐藏关注按钮</string>
    <string name="hide_follow_button_description">隐藏作者头像下方的关注按钮。</string>
    <string name="hide_live_button">隐藏直播按钮</string>
    <string name="hide_live_button_description">隐藏推荐流顶部的直播按钮。</string>
    <string name="hide_quick_comments">隐藏快捷评论</string>
    <string name="hide_quick_comments_description">隐藏视频下方的表情栏。</string>
    <string name="hide_story_ring">隐藏快拍光圈</string>
    <string name="hide_story_ring_description">隐藏作者头像周围的快拍光圈。</string>
    <string name="remove_app_shortcuts">移除应用快捷方式</string>
    <string name="remove_app_shortcuts_description">移除 TikTok 启动器图标上的快捷方式。</string>
    <string name="show_exact_counts">显示精确数字</string>
    <string name="show_exact_counts_description">显示完整数字，例如 12,345 而不是 12.3K。</string>
    <string name="show_poll_results">显示投票结果</string>
    <string name="show_poll_results_description">在你投票前就显示评论中的投票结果。</string>
    <string name="show_upload_date">显示上传日期</string>
    <string name="show_upload_date_description">显示视频发布的时间和地点。</string>
    <string name="clean_share_links">清理分享链接</string>
    <string name="clean_share_links_description">分享不含跟踪参数的普通 tiktok.com 链接。</string>
    <string name="open_links_externally">在浏览器中打开链接</string>
    <string name="open_links_externally_description">用你的浏览器打开链接，而不用 TikTok 内置的浏览器。</string>
    <string name="remove_forward_limit">移除转发限制</string>
    <string name="remove_forward_limit_description">允许一次将帖子分享到更多聊天。</string>
    <string name="disable_hdr">停用 HDR</string>
    <string name="disable_hdr_description">将 HDR 视频作为普通视频播放。</string>
    <string name="disable_looping">停用循环播放</string>
    <string name="disable_looping_description">视频播放完后停止，而不是重新播放。</string>
    <string name="disable_quic">停用 QUIC</string>
    <string name="disable_quic_description">通过 HTTPS 而不是 QUIC 加载视频。</string>
    <string name="keep_refresh_rate">保持刷新率</string>
    <string name="keep_refresh_rate_description">不让 TikTok 降低屏幕刷新率。</string>
    <string name="video_quality">视频画质</string>
    <string name="video_quality_description">限制 TikTok 选择的视频画质。</string>
    <string name="privacy">隐私</string>
    <string name="privacy_description">停止使用情况报告、观看记录报告、正在输入提示和搜索记录保存。</string>
    <string name="spoof_sim">伪装 SIM 卡国家/地区</string>
    <string name="spoof_sim_description">报告一个其他国家/地区的运营商，适用于 TikTok 在你所在地区被封锁的情况。需要使用该国家/地区的 VPN。</string>
    <string name="spoof_sim_country">默认国家/地区</string>
    <string name="spoof_sim_country_description">在你于设置中更改之前所报告的国家/地区。</string>
    <string name="hide_notification_prompts">隐藏通知提示</string>
    <string name="hide_notification_prompts_description">隐藏开启通知的提示。</string>
    <string name="hide_region_popups">隐藏地区弹窗</string>
    <string name="hide_region_popups_description">隐藏提示某功能在你所在地区不可用的弹窗。该功能仍然无法使用。</string>
    <string name="disable_search_autoplay">停用搜索自动播放</string>
    <string name="disable_search_autoplay_description">搜索结果中的视频只在你打开时播放。</string>
    <string name="hide_search_suggestions">隐藏搜索建议</string>
    <string name="hide_search_suggestions_description">隐藏搜索页面上的“猜你喜欢”。</string>
</resources>
