<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="fix_login">修正登入</string>
    <string name="fix_login_description">讓使用 Google 和 Facebook 登入正常運作。</string>
    <string name="hide_ads">隱藏廣告</string>
    <string name="hide_ads_description">隱藏廣告、推廣貼文和啟動時的全螢幕廣告。</string>
    <string name="flag_overrides">功能旗標覆寫</string>
    <string name="flag_overrides_description">依金鑰名稱設定 TikTok 的伺服器設定和實驗。</string>
    <string name="settings_gear">Reseam 設定按鈕</string>
    <string name="settings_gear_description">在「個人檔案」分頁新增一個開啟 Reseam 設定的按鈕。</string>
    <string name="downloads">下載</string>
    <string name="downloads_description">儲存沒有浮水印的影片和相片，即使作者關閉了儲存功能。</string>
    <string name="filter_feed">篩選動態</string>
    <string name="filter_feed_description">依帳號、主題標籤、字詞、地區、觀看次數、按讚數、發布時間或長度隱藏貼文。</string>
    <string name="hide_feed_content">隱藏動態內容</string>
    <string name="hide_feed_content_description">隱藏選取的貼文類型，例如直播、商店或 AI 生成的貼文。</string>
    <string name="inbox">收件匣</string>
    <string name="inbox_description">隱藏收件匣中選取的區塊，例如限時動態和推薦帳號。</string>
    <string name="always_show_seek_bar">一律顯示進度列</string>
    <string name="always_show_seek_bar_description">在每部影片上顯示進度列，而不只是長影片。</string>
    <string name="disable_like_long_press">停用長按按讚</string>
    <string name="disable_like_long_press_description">長按「讚」時不再開啟反應選項。</string>
    <string name="hide_comment_animations">隱藏留言動畫</string>
    <string name="hide_comment_animations_description">阻止留言中某些字詞觸發的全螢幕特效。</string>
    <string name="hide_comment_suggestions">隱藏留言建議</string>
    <string name="hide_comment_suggestions_description">輸入留言時隱藏貼圖和表情符號建議。</string>
    <string name="hide_follow_button">隱藏追蹤按鈕</string>
    <string name="hide_follow_button_description">隱藏作者頭像下方的追蹤按鈕。</string>
    <string name="hide_live_button">隱藏直播按鈕</string>
    <string name="hide_live_button_description">隱藏動態頂端的直播按鈕。</string>
    <string name="hide_quick_comments">隱藏快速留言</string>
    <string name="hide_quick_comments_description">隱藏影片下方的表情符號列。</string>
    <string name="hide_story_ring">隱藏限時動態光環</string>
    <string name="hide_story_ring_description">隱藏作者頭像周圍的限時動態光環。</string>
    <string name="remove_app_shortcuts">移除應用程式捷徑</string>
    <string name="remove_app_shortcuts_description">移除 TikTok 啟動器圖示上的捷徑。</string>
    <string name="show_exact_counts">顯示精確數字</string>
    <string name="show_exact_counts_description">顯示完整數字，例如 12,345 而不是 12.3K。</string>
    <string name="show_poll_results">顯示投票結果</string>
    <string name="show_poll_results_description">在你投票前就顯示留言中的投票結果。</string>
    <string name="show_upload_date">顯示上傳日期</string>
    <string name="show_upload_date_description">顯示影片發布的時間和地點。</string>
    <string name="clean_share_links">清理分享連結</string>
    <string name="clean_share_links_description">分享不含追蹤參數的一般 tiktok.com 連結。</string>
    <string name="open_links_externally">在瀏覽器中開啟連結</string>
    <string name="open_links_externally_description">以你的瀏覽器開啟連結，而不是 TikTok 內建的瀏覽器。</string>
    <string name="remove_forward_limit">移除轉傳限制</string>
    <string name="remove_forward_limit_description">可以一次將貼文分享到更多聊天。</string>
    <string name="disable_hdr">停用 HDR</string>
    <string name="disable_hdr_description">將 HDR 影片以一般影片播放。</string>
    <string name="disable_looping">停用重複播放</string>
    <string name="disable_looping_description">影片播完後停止，而不是重新播放。</string>
    <string name="disable_quic">停用 QUIC</string>
    <string name="disable_quic_description">透過 HTTPS 而不是 QUIC 載入影片。</string>
    <string name="keep_refresh_rate">保持螢幕更新率</string>
    <string name="keep_refresh_rate_description">不讓 TikTok 降低螢幕更新率。</string>
    <string name="video_quality">影片畫質</string>
    <string name="video_quality_description">限制 TikTok 選擇的影片畫質。</string>
    <string name="privacy">隱私權</string>
    <string name="privacy_description">停止使用情形回報、觀看記錄回報、正在輸入提示和搜尋記錄儲存。</string>
    <string name="spoof_sim">偽裝 SIM 卡國家/地區</string>
    <string name="spoof_sim_description">在 TikTok 於你所在地區遭封鎖時，回報其他國家/地區的電信業者。需要使用該國家/地區的 VPN。</string>
    <string name="spoof_sim_country">預設國家/地區</string>
    <string name="spoof_sim_country_description">在你於設定中變更之前所回報的國家/地區。</string>
    <string name="hide_notification_prompts">隱藏通知提示</string>
    <string name="hide_notification_prompts_description">隱藏開啟通知的提示。</string>
    <string name="hide_region_popups">隱藏地區彈出視窗</string>
    <string name="hide_region_popups_description">隱藏表示某功能在你所在地區無法使用的彈出視窗。該功能仍然無法使用。</string>
    <string name="disable_search_autoplay">停用搜尋自動播放</string>
    <string name="disable_search_autoplay_description">搜尋結果中的影片只在你開啟時播放。</string>
    <string name="hide_search_suggestions">隱藏搜尋建議</string>
    <string name="hide_search_suggestions_description">隱藏搜尋頁面上的「你可能會喜歡」。</string>
</resources>
