<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="premium_promotions">Скрыть рекламу Premium</string>
    <string name="premium_promotions_description">Скрывает «Оформить Music Premium» в меню аккаунта и настройках.</string>
    <string name="video_ads">Блокировать видеорекламу</string>
    <string name="video_ads_description">Пропускает рекламу перед треками и между ними.</string>
    <string name="settings_entry">Пункт «Настройки Reseam»</string>
    <string name="settings_entry_description">Добавляет «Настройки Reseam» в настройки YouTube Music.</string>
    <string name="save_to_device">Сохранять на устройство</string>
    <string name="save_to_device_description">Сохраняет скачанные треки и плейлисты как аудиофайлы в выбранную вами папку.</string>
    <string name="unlock_downloads">Разблокировать скачивание</string>
    <string name="unlock_downloads_description">Скачивает треки, альбомы и плейлисты без Premium.</string>
    <string name="hide_action_buttons">Скрыть кнопки действий</string>
    <string name="hide_action_buttons_description">Скрывает выбранные кнопки под плеером.</string>
    <string name="hide_category_bar">Скрыть панель категорий</string>
    <string name="hide_category_bar_description">Скрывает чипы настроений и жанров над лентами.</string>
    <string name="force_portrait">Только портретный режим</string>
    <string name="force_portrait_description">Оставляет приложение в портретном режиме, когда вы поворачиваете телефон.</string>
    <string name="hide_buttons">Скрыть кнопки</string>
    <string name="hide_buttons_description">Скрывает кнопки трансляции, поиска, истории и активности.</string>
    <string name="hide_layout_components">Скрыть элементы интерфейса</string>
    <string name="hide_layout_components_description">Скрывает полку «Быстрый доступ» и выбранные части плеера.</string>
    <string name="hide_menu_items">Скрыть пункты меню</string>
    <string name="hide_menu_items_description">Скрывает выбранные пункты меню долгого нажатия и меню с тремя точками.</string>
    <string name="miniplayer_buttons">Кнопки перехода в мини-плеере</string>
    <string name="miniplayer_buttons_description">Добавляет в мини-плеер кнопки «Назад» и «Далее».</string>
    <string name="navigation_bar">Панель навигации</string>
    <string name="navigation_bar_description">Скрывает выбранные вкладки панели навигации.</string>
    <string name="hide_settings_menu_items">Скрыть пункты меню настроек</string>
    <string name="hide_settings_menu_items_description">Скрывает выбранные строки настроек YouTube Music.</string>
    <string name="start_minimized">Начинать в мини-плеере</string>
    <string name="start_minimized_description">Оставляет новый трек в мини-плеере, не открывая полный плеер.</string>
    <string name="start_page">Начальная страница</string>
    <string name="start_page_description">Открывает выбранную вами страницу вместо главной.</string>
    <string name="theme">Тема</string>
    <string name="theme_description">Заменяет чёрный фон выбранным вами цветом.</string>
    <string name="theme_background_color">Цвет фона</string>
    <string name="theme_background_color_description">Цвет, который заменяет чёрный фон, в формате #AARRGGBB.</string>
    <string name="sanitize_sharing_links">Очищать ссылки при отправке</string>
    <string name="sanitize_sharing_links_description">Убирает отслеживание из ссылок, которыми вы делитесь.</string>
    <string name="spoof_video_streams">Исправить воспроизведение</string>
    <string name="spoof_video_streams_description">Видео воспроизводятся, когда YouTube Music блокирует приложение.</string>
    <string name="user_agent_client_spoof">Подменить user agent</string>
    <string name="user_agent_client_spoof_description">Сообщает в запросах исходное приложение, чтобы YouTube Music их принимал.</string>
    <string name="audio_only_playback">Воспроизведение только аудио</string>
    <string name="audio_only_playback_description">Открывает «Не воспроизводить видеоклипы», с которым треки играют без видео.</string>
    <string name="background_playback">Фоновое воспроизведение</string>
    <string name="background_playback_description">Продолжает играть в фоне и при выключенном экране.</string>
    <string name="force_original_audio">Всегда оригинальная звуковая дорожка</string>
    <string name="force_original_audio_description">Воспроизводит оригинальный звук вместо дублированной дорожки.</string>
    <string name="playback_speed">Скорость воспроизведения</string>
    <string name="playback_speed_description">Воспроизводит каждый трек с выбранной вами скоростью.</string>
    <string name="sponsor_block">SponsorBlock</string>
    <string name="sponsor_block_description">Пропускает части клипов без музыки, отмеченные сообществом SponsorBlock.</string>
</resources>
