    <string name="start_page">Початкова сторінка</string>
    <string name="start_page_description">Відкриває вибрану вами сторінку замість головної.</string>
    <string name="theme">Тема</string>
    <string name="theme_description">Замінює чорний фон вибраним кольором.</string>
    <string name="theme_background_color">Колір фону</string>
    <string name="theme_background_color_description">Колір замість чорного фону, у форматі #AARRGGBB.</string>
    <string name="sanitize_sharing_links">Очищати посилання для поширення</string>
