    <string name="save_to_device">Зберегти на пристрій</string>
    <string name="save_to_device_description">Зберігає завантажені пісні й плейлисти як аудіофайли у вибраній вами папці.</string>
    <string name="unlock_downloads">Відкрити завантаження</string>
    <string name="unlock_downloads_description">Завантажує пісні, альбоми й плейлисти без Premium.</string>
    <string name="hide_action_buttons">Приховати кнопки дій</string>
    <string name="hide_action_buttons_description">Приховує вибрані кнопки під плеєром.</string>
    <string name="hide_category_bar">Приховати панель категорій</string>
