    <string name="audio_only_playback">Відтворення лише аудіо</string>
    <string name="audio_only_playback_description">Відкриває «Не відтворювати музичні відео», що відтворює пісні без відео.</string>
    <string name="background_playback">Фонове відтворення</string>
    <string name="background_playback_description">Продовжує відтворення у фоні й з вимкненим екраном.</string>
    <string name="force_original_audio">Примусово оригінальне аудіо</string>
    <string name="force_original_audio_description">Відтворює оригінальне аудіо замість дубляжу.</string>
    <string name="playback_speed">Швидкість відтворення</string>
    <string name="playback_speed_description">Відтворює кожну пісню з вибраною швидкістю.</string>
    <string name="sponsor_block">SponsorBlock</string>
    <string name="sponsor_block_description">Пропускає немузичні частини музичних відео, позначені спільнотою SponsorBlock.</string>
</resources>
