    <string name="force_original_audio">強制使用原始音訊</string>
    <string name="force_original_audio_description">播放原始音訊，而不是配音音軌。</string>
    <string name="playback_speed">播放速度</string>
    <string name="playback_speed_description">以你選擇的速度播放每首歌曲。</string>
    <string name="sponsor_block">SponsorBlock</string>
    <string name="sponsor_block_description">略過音樂影片中由 SponsorBlock 社群標示為非音樂的部分。</string>
</resources>
