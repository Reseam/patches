    <string name="navigation_bar_description">隱藏導覽列中選取的分頁。</string>
    <string name="hide_settings_menu_items">隱藏設定選單項目</string>
    <string name="hide_settings_menu_items_description">隱藏 YouTube Music 設定中選取的項目。</string>
    <string name="start_minimized">以迷你播放器開始</string>
    <string name="start_minimized_description">新歌曲停留在迷你播放器中，而不是開啟完整播放器。</string>
    <string name="start_page">起始頁面</string>
    <string name="start_page_description">開啟你選擇的頁面，而不是首頁。</string>
    <string name="theme">主題</string>
    <string name="theme_description">將黑色背景換成你選擇的顏色。</string>
    <string name="theme_background_color">背景顏色</string>
    <string name="theme_background_color_description">取代黑色背景的顏色，格式為 #AARRGGBB。</string>
    <string name="sanitize_sharing_links">清理分享連結</string>
    <string name="sanitize_sharing_links_description">移除你分享的連結中的追蹤參數。</string>
    <string name="spoof_video_streams">修正播放</string>
    <string name="spoof_video_streams_description">在 YouTube Music 封鎖這個應用程式時，讓影片仍能播放。</string>
    <string name="user_agent_client_spoof">偽裝使用者代理程式</string>
    <string name="user_agent_client_spoof_description">在請求中回報為原版應用程式，讓 YouTube Music 接受這些請求。</string>
    <string name="audio_only_playback">只播放音訊</string>
