<resources>
    <string name="premium_promotions">隱藏 Premium 推廣</string>
    <string name="premium_promotions_description">隱藏帳號選單和設定中的「取得 Music Premium」。</string>
    <string name="video_ads">封鎖影片廣告</string>
    <string name="video_ads_description">略過歌曲前和歌曲之間的廣告。</string>
    <string name="settings_entry">Reseam 設定入口</string>
    <string name="settings_entry_description">在 YouTube Music 的設定中新增 Reseam 設定。</string>
    <string name="save_to_device">儲存到裝置</string>
    <string name="save_to_device_description">將下載的歌曲和播放清單以音訊檔案儲存到你選擇的資料夾。</string>
    <string name="unlock_downloads">解鎖下載</string>
    <string name="unlock_downloads_description">不需 Premium 即可下載歌曲、專輯和播放清單。</string>
    <string name="hide_action_buttons">隱藏操作按鈕</string>
    <string name="hide_action_buttons_description">隱藏播放器下方選取的按鈕。</string>
    <string name="hide_category_bar">隱藏類別列</string>
