<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="premium_promotions">隐藏 Premium 推广</string>
    <string name="premium_promotions_description">隐藏帐户菜单和设置中的“获取 Music Premium”。</string>
    <string name="video_ads">阻止视频广告</string>
    <string name="video_ads_description">跳过歌曲前和歌曲之间的广告。</string>
    <string name="settings_entry">Reseam 设置入口</string>
    <string name="settings_entry_description">在 YouTube Music 的设置中添加 Reseam 设置。</string>
    <string name="save_to_device">保存到设备</string>
    <string name="save_to_device_description">将下载的歌曲和播放列表作为音频文件保存到你选择的文件夹。</string>
    <string name="unlock_downloads">解锁下载</string>
    <string name="unlock_downloads_description">无需 Premium 即可下载歌曲、专辑和播放列表。</string>
    <string name="hide_action_buttons">隐藏操作按钮</string>
    <string name="hide_action_buttons_description">隐藏播放器下方选定的按钮。</string>
    <string name="hide_category_bar">隐藏类别栏</string>
    <string name="hide_category_bar_description">隐藏推荐流上方的心情和曲风标签。</string>
    <string name="force_portrait">强制竖屏</string>
    <string name="force_portrait_description">旋转手机时让应用保持竖屏。</string>
    <string name="hide_buttons">隐藏按钮</string>
    <string name="hide_buttons_description">隐藏投放、搜索、历史记录和动态按钮。</string>
    <string name="hide_layout_components">隐藏布局组件</string>
    <string name="hide_layout_components_description">隐藏“快速选曲”版块和播放器中选定的部分。</string>
    <string name="hide_menu_items">隐藏菜单项</string>
    <string name="hide_menu_items_description">隐藏长按菜单和三点菜单中选定的项目。</string>
    <string name="miniplayer_buttons">迷你播放器跳曲按钮</string>
    <string name="miniplayer_buttons_description">为迷你播放器添加上一首和下一首按钮。</string>
    <string name="navigation_bar">导航栏</string>
    <string name="navigation_bar_description">隐藏导航栏中选定的标签页。</string>
    <string name="hide_settings_menu_items">隐藏设置菜单项</string>
    <string name="hide_settings_menu_items_description">隐藏 YouTube Music 设置中选定的行。</string>
    <string name="start_minimized">以迷你播放器开始</string>
    <string name="start_minimized_description">新歌曲停留在迷你播放器中，而不打开完整播放器。</string>
    <string name="start_page">起始页面</string>
    <string name="start_page_description">打开你选择的页面，而不是首页。</string>
    <string name="theme">主题</string>
    <string name="theme_description">将黑色背景替换为你选择的颜色。</string>
    <string name="theme_background_color">背景颜色</string>
    <string name="theme_background_color_description">替换黑色背景的颜色，格式为 #AARRGGBB。</string>
    <string name="sanitize_sharing_links">清理分享链接</string>
    <string name="sanitize_sharing_links_description">移除你分享的链接中的跟踪参数。</string>
    <string name="spoof_video_streams">修复播放</string>
    <string name="spoof_video_streams_description">在 YouTube Music 阻止此应用时让视频仍能播放。</string>
    <string name="user_agent_client_spoof">伪装用户代理</string>
    <string name="user_agent_client_spoof_description">在请求中报告为原版应用，使 YouTube Music 接受这些请求。</string>
    <string name="audio_only_playback">仅音频播放</string>
    <string name="audio_only_playback_description">解锁“不播放音乐视频”，播放歌曲时不带视频。</string>
    <string name="background_playback">后台播放</string>
    <string name="background_playback_description">在后台和关闭屏幕时继续播放。</string>
    <string name="force_original_audio">强制原始音频</string>
    <string name="force_original_audio_description">播放原始音频，而不是配音音轨。</string>
    <string name="playback_speed">播放速度</string>
    <string name="playback_speed_description">以你选择的速度播放每首歌曲。</string>
    <string name="sponsor_block">SponsorBlock</string>
    <string name="sponsor_block_description">跳过音乐视频中由 SponsorBlock 社区标记为非音乐的部分。</string>
</resources>
