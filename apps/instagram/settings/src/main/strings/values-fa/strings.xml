    <string name="hide_suggested_accounts">پنهان کردن حساب‌های پیشنهادی</string>
    <string name="hide_suggested_accounts_summary">پست‌های پیشنهادی می‌مانند. «فید فقط دنبال‌شده‌ها» آن‌ها را پنهان می‌کند.</string>
    <string name="hide_threads_units">پنهان کردن بخش‌های Threads</string>
    <string name="hide_threads_units_summary">ممکن است جای خالی در «خانه» بگذارد.</string>
    <string name="hide_shopping_units">پنهان کردن بخش‌های خرید</string>
