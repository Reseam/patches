    <string name="hide_typing">پنهان کردن نشانگر تایپ</string>
    <string name="hide_typing_summary">دیگران نمی‌بینند که در حال تایپ هستید. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="hide_dm_seen">پنهان کردن خوانده‌شدن دایرکت</string>
    <string name="hide_dm_seen_summary">فرستنده‌ها نمی‌بینند پیامشان را خوانده‌اید، مگر اینکه در «انتخاب گفتگوها» گزینهٔ «علامت‌گذاری به‌عنوان خوانده‌شده» را بزنید. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="hide_story_seen">پنهان کردن بازدید استوری</string>
    <string name="hide_story_seen_summary">نامتان در فهرست بینندگان استوری نمی‌آید. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="hide_live_seen">پنهان کردن تماشای پخش زنده</string>
    <string name="hide_live_seen_summary">به‌عنوان بینندهٔ ویدیوهای زنده نشان داده نمی‌شوید. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="hide_screenshot_notifications">پنهان کردن اعلان نماگرفت</string>
    <string name="hide_screenshot_notifications_summary">وقتی نماگرفت می‌گیرید، به دیگران خبر داده نمی‌شود. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="max_resolution">عکس‌های با وضوح کامل</string>
    <string name="original_quality">کیفیت اصلی عکس</string>
    <string name="original_quality_summary">با اعلام صفحه‌نمایشی بزرگ‌تر، عکس‌ها را همان‌طور که بارگذاری شده‌اند بار می‌کند. ممکن است Instagram حسابتان را مسدود کند.</string>
    <string name="disable_video_autoplay">غیرفعال کردن پخش خودکار ویدیو</string>
    <string name="disable_video_autoplay_summary">ویدیوهای فید را فقط وقتی رویشان ضربه بزنید پخش می‌کند.</string>
    <string name="disable_reels_swiping">غیرفعال کردن تند کشیدن در ریلز</string>
    <string name="disable_reels_swiping_summary">ریلز را روی همان ریلی که باز کرده‌اید نگه می‌دارد.</string>
    <string name="swipe_in_reels_tab">ادامهٔ تند کشیدن در برگهٔ ریلز</string>
    <string name="swipe_in_reels_tab_summary">در این حالت، «غیرفعال کردن تند کشیدن در ریلز» فقط برای ریلزی اعمال می‌شود که از پست‌ها، گفتگوها و اکسپلور باز می‌کنید.</string>
    <string name="disable_auto_advance">غیرفعال کردن رفتن خودکار به استوری بعدی</string>
    <string name="disable_auto_advance_summary">استوری تمام‌شده را تا وقتی ضربه بزنید روی صفحه نگه می‌دارد.</string>
    <string name="hide_suggested_users">پنهان کردن استوری‌های پیشنهادی</string>
    <string name="hide_suggested_users_summary">استوری‌ها و حساب‌هایی را که دنبال نمی‌کنید در ردیف استوری‌ها پنهان می‌کند.</string>
    <string name="hide_story_tray">پنهان کردن ردیف استوری‌ها</string>
    <string name="hide_story_tray_summary">استوری‌های بالای «خانه» را پنهان می‌کند.</string>
    <string name="ring_size">اندازهٔ حلقهٔ استوری</string>
    <string name="ring_size_summary">اندازهٔ دایره‌های استوری بالای «خانه».</string>
    <string name="ring_size_small">کوچک (۸۰٪)</string>
    <string name="ring_size_default">پیش‌فرض</string>
    <string name="ring_size_large">بزرگ (۱۲۰٪)</string>
    <string name="ring_size_extra_large">خیلی بزرگ (۱۴۰٪)</string>
    <string name="hide_in_explore_search">پنهان کردن Meta AI در جستجوی اکسپلور</string>
    <string name="hide_in_direct">پنهان کردن Meta AI در دایرکت</string>
    <string name="hide_in_direct_summary">Meta AI را در صندوق پیام، جستجوی دایرکت و گفتگوها پنهان می‌کند.</string>
    <string name="hide_in_posts">پنهان کردن Meta AI در پست‌ها</string>
    <string name="hide_in_posts_summary">خلاصهٔ پست و «پرسیدن از Meta AI» را در منوی پست‌ها پنهان می‌کند.</string>
    <string name="open_externally">باز کردن پیوندها در مرورگر</string>
    <string name="clean_share_links">پاک‌سازی پیوندهای هم‌رسانی</string>
    <string name="clean_share_links_summary">بخشی از پیوندهای هم‌رسانی‌شده را که هویت شما را نشان می‌دهد حذف می‌کند.</string>
    <string name="share_link_provider">ارائه‌دهندهٔ پیوند هم‌رسانی</string>
    <string name="share_link_provider_summary">میزبان پیوندهای هم‌رسانی‌شدهٔ پست و ریلز. این میزبان‌ها ویدیو را در Discord و Telegram نشان می‌دهند.</string>
    <string name="share_link_provider_custom">سفارشی</string>
    <string name="share_link_provider_off">خاموش (instagram.com)</string>
    <string name="custom_share_link_host">میزبان سفارشی پیوند هم‌رسانی</string>
    <string name="custom_share_link_host_summary">وقتی ارائه‌دهنده «سفارشی» است استفاده می‌شود، مثلاً kkinstagram.com.</string>
    <string name="allow_screenshots">مجاز کردن نماگرفت</string>
    <string name="allow_screenshots_summary">شامل گفتگوها، رسانه‌های یک‌بار مشاهده و حالت ناپدید.</string>
    <string name="unlock_developer_options">فعال کردن منوی توسعه‌دهنده</string>
    <string name="unlock_developer_options_summary">منوی توسعه‌دهندهٔ Instagram را به پایین تنظیمات اضافه می‌کند.</string>
    <string name="copy_comment">کپی نظر</string>
    <string name="copy_comment_summary">گزینهٔ «کپی» را به منوی لمس طولانی نظرها اضافه می‌کند.</string>
    <string name="comment_copied">نظر کپی شد</string>
    <string name="follows_you_indicator">نشانگر «شما را دنبال می‌کند»</string>
    <string name="follows_you_indicator_summary">در نمایهٔ حساب‌هایی که شما را دنبال می‌کنند، «شما را دنبال می‌کند» را نشان می‌دهد.</string>
    <string name="disable_double_tap_like">غیرفعال کردن پسندیدن با دو ضربه</string>
    <string name="disable_double_tap_like_summary">برای پست‌ها، ریلز، نظرها و پیام‌ها اعمال می‌شود.</string>
    <string name="hide_repost_buttons">پنهان کردن دکمه‌های بازنشر</string>
    <string name="hide_engagement_counts">پنهان کردن تعداد تعامل‌ها</string>
    <string name="hide_engagement_counts_summary">تعداد پسندها، نظرها، هم‌رسانی‌ها و بازنشرها را در فید پنهان می‌کند.</string>
    <string name="hide_explore_grid">پنهان کردن شبکهٔ اکسپلور</string>
    <string name="hide_explore_grid_summary">در برگهٔ اکسپلور فقط جستجو را باقی می‌گذارد.</string>
    <string name="hide_instants">پنهان کردن Instants</string>
    <string name="hide_instants_summary">دستهٔ Instants را در صندوق پیام پنهان می‌کند.</string>
    <string name="hide_threads_badge">پنهان کردن نشان Threads</string>
    <string name="hide_profile_suggestions">پنهان کردن حساب‌های پیشنهادی در نمایه‌ها</string>
    <string name="hide_profile_suggestions_summary">«یافتن افراد» را در نمایهٔ شما و «پیشنهاد برای شما» را در نمایهٔ دیگران پنهان می‌کند.</string>
