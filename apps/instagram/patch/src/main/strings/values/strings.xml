<resources>
    <string name="hide_ads">Hide ads</string>
    <string name="hide_ads_description">Hides sponsored posts in feed, stories, Explore, Reels and search.</string>
    <string name="copy_comment">Copy comment</string>
    <string name="copy_comment_description">Adds Copy to the long-press menu of comments.</string>
    <string name="clone_instagram">Clone Instagram</string>
    <string name="clone_instagram_description">Installs the app next to the official Instagram under another package name.</string>
    <string name="clone_instagram_package_name">Package name</string>
    <string name="clone_instagram_package_name_description">The clone\'s package name.</string>
    <string name="clone_instagram_app_name">App name</string>
    <string name="clone_instagram_app_name_description">The clone\'s name on your home screen.</string>
    <string name="hide_instants">Hide Instants</string>
    <string name="hide_instants_description">Hides the Instants stack in the inbox.</string>
    <string name="hide_explore_grid">Hide Explore grid</string>
    <string name="hide_explore_grid_description">Leaves only search on the Explore tab.</string>
    <string name="following_feed">Following-only feed</string>
    <string name="following_feed_description">Shows only posts from accounts you follow in Home.</string>
    <string name="hide_feed_units">Hide suggested carousels</string>
    <string name="hide_feed_units_description">Hides suggested accounts, Threads, shopping and Reels carousels in Home.</string>
    <string name="follows_you">Follows you indicator</string>
    <string name="follows_you_description">Shows Follows you on the profiles of accounts that follow you.</string>
    <string name="hide_engagement_counts">Hide engagement counts</string>
    <string name="hide_engagement_counts_description">Hides like, comment, share and repost counts.</string>
    <string name="hide_repost_buttons">Hide repost buttons</string>
    <string name="hide_repost_buttons_description">Hides repost buttons in the feed and Reels.</string>
    <string name="clean_share_links">Clean share links</string>
    <string name="clean_share_links_description">Removes the part of shared links that identifies you.</string>
    <string name="open_links_externally">Open links in browser</string>
    <string name="open_links_externally_description">Opens links in your browser instead of Instagram\'s.</string>
    <string name="disable_autoplay">Disable video autoplay</string>
    <string name="disable_autoplay_description">Stops videos in the feed and Reels from playing by themselves.</string>
    <string name="max_resolution">Full-resolution images</string>
    <string name="max_resolution_description">Loads images in the highest resolution, or the original upload.</string>
    <string name="download_instants">Download Instants</string>
    <string name="download_instants_description">Adds a download button to Instants.</string>
    <string name="download_media">Download media</string>
    <string name="download_media_description">Adds Download to the menus of posts, Reels and stories.</string>
    <string name="download_voice_messages">Download voice messages</string>
    <string name="download_voice_messages_description">Adds Save to the menu of voice messages.</string>
    <string name="hide_meta_ai">Hide Meta AI</string>
    <string name="hide_meta_ai_description">Hides Meta AI in search, chats and the post menu.</string>
    <string name="enable_developer_menu">Enable developer menu</string>
    <string name="enable_developer_menu_description">Adds Instagram\'s developer menu at the bottom of settings.</string>
    <string name="hide_navigation_tabs">Hide navigation tabs</string>
    <string name="hide_navigation_tabs_description">Hides chosen tabs of the navigation bar.</string>
    <string name="allow_screenshots">Allow screenshots in chats</string>
    <string name="allow_screenshots_description">Allows screenshots of chats, view-once media and vanish mode.</string>
    <string name="ghost_mode">Ghost mode</string>
    <string name="ghost_mode_description">Hides your typing, reads, story views and screenshots from others. Instagram may ban accounts that use it.</string>
    <string name="hide_threads_badge">Hide Threads badge</string>
    <string name="hide_threads_badge_description">Hides the Threads badge and link on profiles.</string>
    <string name="disable_reels_swiping">Disable Reels swiping</string>
    <string name="disable_reels_swiping_description">Keeps Reels on the reel you opened.</string>
    <string name="disable_story_auto_advance">Disable story auto-advance</string>
    <string name="disable_story_auto_advance_description">Keeps a finished story on screen until you tap.</string>
    <string name="hide_story_suggestions">Hide suggested stories</string>
    <string name="hide_story_suggestions_description">Hides stories and accounts you don\'t follow in the story tray.</string>
    <string name="hide_story_tray">Hide story tray</string>
    <string name="hide_story_tray_description">Hides the stories at the top of Home.</string>
    <string name="story_ring_size">Story ring size</string>
    <string name="story_ring_size_description">Changes the size of the story circles at the top of Home.</string>
</resources>
