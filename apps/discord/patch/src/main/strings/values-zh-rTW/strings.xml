<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="custom_themes">自訂主題</string>
    <string name="custom_themes_description">可以建立、編輯、分享和使用主題，包括 Reseam 主題。</string>
    <string name="add_source_cards">新增來源卡片</string>
    <string name="add_source_cards_description">將修補程式來源連結顯示為卡片，並附上「新增到 Reseam Manager」按鈕。</string>
    <string name="clean_outgoing_links">清理傳送的連結</string>
    <string name="clean_outgoing_links_description">傳送連結時移除其中的追蹤參數。</string>
    <string name="colored_names">彩色名稱</string>
    <string name="colored_names_description">在提及、正在輸入、語音頻道和成員清單中，以身分組顏色顯示名稱。</string>
    <string name="delete_without_confirmation">刪除時不需確認</string>
    <string name="delete_without_confirmation_description">從長按選單刪除自己的訊息時不再詢問。</string>
    <string name="disable_message_swipes">停用訊息滑動</string>
    <string name="disable_message_swipes_description">在訊息上滑動時不再開始回覆或編輯。</string>
    <string name="draft_preview">草稿預覽</string>
    <string name="draft_preview_description">長按傳送按鈕，即可在傳送前預覽訊息。</string>
    <string name="hide_blocked_messages">隱藏已封鎖的訊息</string>
    <string name="hide_blocked_messages_description">隱藏已封鎖和已忽略使用者的訊息。</string>
    <string name="instant_chat_jumps">聊天即時跳轉</string>
    <string name="instant_chat_jumps_description">直接跳到訊息，不經過捲動。</string>
    <string name="jump_to_first_message">跳到第一則訊息</string>
    <string name="jump_to_first_message_description">新增一個按鈕，可跳到聊天的第一則訊息。</string>
    <string name="keep_deleted_messages">保留已刪除的訊息</string>
    <string name="keep_deleted_messages_description">已載入的訊息被刪除後仍會保留，並以紅色標示。</string>
    <string name="local_edit_history">本機編輯記錄</string>
    <string name="local_edit_history_description">對你看過的已編輯訊息，最多顯示三個較早的版本。</string>
    <string name="moderator_badges">管理員徽章</string>
    <string name="moderator_badges_description">在聊天中，於擁有者、管理員和版主的名稱旁加上標示。</string>
    <string name="precise_timestamps">精確時間戳記</string>
    <string name="precise_timestamps_description">在聊天時間戳記中顯示秒數。</string>
    <string name="quick_reply_and_delete">快速回覆和刪除</string>
    <string name="quick_reply_and_delete_description">輕觸兩下自己的訊息即可回覆，再輕觸一次即可刪除。</string>
    <string name="replies_without_pings">不通知的回覆</string>
    <string name="replies_without_pings_description">開始回覆時預設關閉提及。</string>
    <string name="reveal_spoilers">顯示暴雷內容</string>
    <string name="reveal_spoilers_description">不需輕觸即可顯示暴雷內容。</string>
    <string name="show_blocked_messages">顯示已封鎖的訊息</string>
    <string name="show_blocked_messages_description">不需解除封鎖即可顯示已封鎖使用者的訊息。</string>
    <string name="skip_masked_link_warnings">略過隱藏連結警告</string>
    <string name="skip_masked_link_warnings_description">開啟隱藏連結時不顯示警告。</string>
    <string name="developer_menu">啟用開發人員選單</string>
    <string name="developer_menu_description">在設定中顯示 Discord 的開發人員工具。</string>
    <string name="mark_all_servers_read">將所有伺服器標示為已讀</string>
    <string name="mark_all_servers_read_description">在每個伺服器的選單中新增「將所有伺服器標示為已讀」。</string>
    <string name="server_details">伺服器詳細資料</string>
    <string name="server_details_description">在伺服器選項中顯示擁有者、建立日期、成員數和加成數。</string>
    <string name="hide_activity_invites">隱藏活動邀請</string>
    <string name="hide_activity_invites_description">隱藏訊息中的活動邀請卡片。</string>
    <string name="hide_contact_sync_prompt">隱藏聯絡人同步提示</string>
    <string name="hide_contact_sync_prompt_description">隱藏好友畫面上的聯絡人同步提示。</string>
    <string name="hide_gift_button">隱藏禮物按鈕</string>
    <string name="hide_gift_button_description">隱藏訊息框中的禮物按鈕。</string>
    <string name="hide_gift_cards">隱藏禮物卡片</string>
    <string name="hide_gift_cards_description">隱藏訊息中的禮物卡片。</string>
    <string name="hide_group_chat_promotion">隱藏群組聊天推廣</string>
    <string name="hide_group_chat_promotion_description">隱藏群組聊天中的 Nitro 推廣。</string>
    <string name="hide_link_cards">隱藏連結卡片</string>
    <string name="hide_link_cards_description">隱藏連結預覽，保留連結、附件、表情符號和貼圖。</string>
    <string name="hide_nitro_buttons">隱藏 Nitro 按鈕</string>
    <string name="hide_nitro_buttons_description">隱藏整個應用程式中的 Nitro 按鈕。</string>
    <string name="hide_picker_promotions">隱藏選擇器推廣</string>
    <string name="hide_picker_promotions_description">隱藏表情符號和貼圖搜尋中的 Nitro 推廣。</string>
    <string name="hide_quests">隱藏任務</string>
    <string name="hide_quests_description">隱藏任務卡片、個人檔案按鈕和任務設定。</string>
    <string name="hide_reactions">隱藏反應</string>
    <string name="hide_reactions_description">隱藏訊息下方的反應。</string>
    <string name="hide_reply_previews">隱藏回覆預覽</string>
    <string name="hide_reply_previews_description">隱藏回覆上方引用的訊息。</string>
    <string name="hide_shop_entry">隱藏商店</string>
    <string name="hide_shop_entry_description">隱藏個人檔案和設定中的商店按鈕。</string>
    <string name="hide_theme_activity_previews">隱藏主題中的活動預覽</string>
    <string name="hide_theme_activity_previews_description">隱藏外觀預覽中的活動卡片。</string>
    <string name="better_stream_quality">更好的直播畫質</string>
    <string name="better_stream_quality_description">以 Nitro 的解析度和影格速率直播你的螢幕。</string>
    <string name="better_video_quality">更好的影片畫質</string>
    <string name="better_video_quality_description">以更高畫質上傳影片。上傳限制維持不變。</string>
    <string name="chat_animation_switch">聊天動畫開關</string>
    <string name="chat_animation_switch_description">讓 GIF 自動播放開關同時停止聊天中的表情符號動畫。</string>
    <string name="disable_call_idle">停用通話閒置</string>
    <string name="disable_call_idle_description">空的私訊通話超過 3 分鐘後仍讓你留在通話中。</string>
    <string name="quiet_super_reactions">安靜的超級反應</string>
    <string name="quiet_super_reactions_description">讓超級反應動畫不再重複播放。</string>
    <string name="static_chat_emoji">靜態聊天表情符號</string>
    <string name="static_chat_emoji_description">讓聊天中的自訂表情符號不再播放動畫。</string>
    <string name="static_chat_gifs">靜態聊天 GIF</string>
    <string name="static_chat_gifs_description">讓聊天中的 GIF 不再自動播放。</string>
    <string name="static_stickers">靜態貼圖</string>
    <string name="static_stickers_description">將貼圖顯示為靜態圖片。</string>
    <string name="freemoji">Freemoji</string>
    <string name="freemoji_description">將鎖定的自訂表情符號以圖片連結傳送。</string>
    <string name="local_themes">本機主題</string>
    <string name="local_themes_description">在這支手機上解鎖 Nitro 主題。</string>
    <string name="premium_app_icons">Premium 應用程式圖示</string>
    <string name="premium_app_icons_description">解鎖 Nitro 應用程式圖示。</string>
    <string name="sticker_links">貼圖連結</string>
    <string name="sticker_links_description">將鎖定的貼圖以圖片連結傳送。</string>
    <string name="block_analytics">封鎖分析</string>
    <string name="block_analytics_description">阻止 Discord 記錄你的操作。</string>
    <string name="block_crash_reports">封鎖當機報告</string>
    <string name="block_crash_reports_description">阻止 Discord 傳送當機報告。</string>
    <string name="hide_typing_indicator">隱藏正在輸入提示</string>
    <string name="hide_typing_indicator_description">不讓別人看到你正在輸入。</string>
    <string name="local_read_state">本機已讀狀態</string>
    <string name="local_read_state_description">只在這支手機上將訊息標示為已讀。</string>
    <string name="keep_patched_bundle">更新後保留修補程式</string>
    <string name="keep_patched_bundle_description">防止 Discord 的應用程式內程式碼更新移除你的修補程式。</string>
</resources>
