<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="custom_themes">自定义主题</string>
    <string name="custom_themes_description">可以创建、编辑、分享和使用主题，包括 Reseam 主题。</string>
    <string name="add_source_cards">添加来源卡片</string>
    <string name="add_source_cards_description">将补丁来源链接显示为卡片，并附带“添加到 Reseam Manager”按钮。</string>
    <string name="clean_outgoing_links">清理发送的链接</string>
    <string name="clean_outgoing_links_description">发送链接时移除其中的跟踪参数。</string>
    <string name="colored_names">彩色名称</string>
    <string name="colored_names_description">在提及、正在输入、语音频道和成员列表中，用身份组颜色显示名称。</string>
    <string name="delete_without_confirmation">无需确认即可删除</string>
    <string name="delete_without_confirmation_description">从长按菜单删除自己的消息时不再询问。</string>
    <string name="disable_message_swipes">停用消息滑动</string>
    <string name="disable_message_swipes_description">在消息上滑动时不再开始回复或编辑。</string>
    <string name="draft_preview">草稿预览</string>
    <string name="draft_preview_description">长按发送按钮，可在发送前预览消息。</string>
    <string name="hide_blocked_messages">隐藏已屏蔽的消息</string>
    <string name="hide_blocked_messages_description">隐藏已屏蔽和已忽略用户的消息。</string>
    <string name="instant_chat_jumps">即时跳转聊天</string>
    <string name="instant_chat_jumps_description">直接跳到消息位置，不经过滚动。</string>
    <string name="jump_to_first_message">跳到第一条消息</string>
    <string name="jump_to_first_message_description">添加一个按钮，可跳到聊天的第一条消息。</string>
    <string name="keep_deleted_messages">保留已删除的消息</string>
    <string name="keep_deleted_messages_description">已加载的消息被删除后仍会保留，并以红色标出。</string>
    <string name="local_edit_history">本地编辑记录</string>
    <string name="local_edit_history_description">对你看到过的已编辑消息，最多显示三个较早的版本。</string>
    <string name="moderator_badges">管理员徽章</string>
    <string name="moderator_badges_description">在聊天中，于所有者、管理员和版主的名字旁加上标记。</string>
    <string name="precise_timestamps">精确时间戳</string>
    <string name="precise_timestamps_description">在聊天时间戳中显示秒数。</string>
    <string name="quick_reply_and_delete">快速回复和删除</string>
    <string name="quick_reply_and_delete_description">双击自己的消息即可回复，再点一次即可删除。</string>
    <string name="replies_without_pings">不提醒的回复</string>
    <string name="replies_without_pings_description">开始回复时默认关闭提及。</string>
    <string name="reveal_spoilers">显示剧透内容</string>
    <string name="reveal_spoilers_description">无需点击即可显示剧透内容。</string>
    <string name="show_blocked_messages">显示已屏蔽的消息</string>
    <string name="show_blocked_messages_description">无需解除屏蔽即可显示已屏蔽用户的消息。</string>
    <string name="skip_masked_link_warnings">跳过隐藏链接警告</string>
    <string name="skip_masked_link_warnings_description">打开隐藏链接时不显示警告。</string>
    <string name="developer_menu">启用开发者菜单</string>
    <string name="developer_menu_description">在设置中显示 Discord 的开发者工具。</string>
    <string name="mark_all_servers_read">将所有服务器标为已读</string>
    <string name="mark_all_servers_read_description">在每个服务器的菜单中添加“将所有服务器标为已读”。</string>
    <string name="server_details">服务器详情</string>
    <string name="server_details_description">在服务器选项中显示其所有者、创建日期、成员数和助力数。</string>
    <string name="hide_activity_invites">隐藏活动邀请</string>
    <string name="hide_activity_invites_description">隐藏消息中的活动邀请卡片。</string>
    <string name="hide_contact_sync_prompt">隐藏通讯录同步提示</string>
    <string name="hide_contact_sync_prompt_description">隐藏好友页面上的通讯录同步提示。</string>
    <string name="hide_gift_button">隐藏礼物按钮</string>
    <string name="hide_gift_button_description">隐藏消息框中的礼物按钮。</string>
    <string name="hide_gift_cards">隐藏礼物卡片</string>
    <string name="hide_gift_cards_description">隐藏消息中的礼物卡片。</string>
    <string name="hide_group_chat_promotion">隐藏群聊推广</string>
    <string name="hide_group_chat_promotion_description">隐藏群聊中的 Nitro 推广。</string>
    <string name="hide_link_cards">隐藏链接卡片</string>
    <string name="hide_link_cards_description">隐藏链接预览，保留链接、附件、表情和贴纸。</string>
    <string name="hide_nitro_buttons">隐藏 Nitro 按钮</string>
    <string name="hide_nitro_buttons_description">隐藏整个应用中的 Nitro 按钮。</string>
    <string name="hide_picker_promotions">隐藏选择器推广</string>
    <string name="hide_picker_promotions_description">隐藏表情和贴纸搜索中的 Nitro 推广。</string>
    <string name="hide_quests">隐藏任务</string>
    <string name="hide_quests_description">隐藏任务卡片、个人资料中的按钮和任务设置。</string>
    <string name="hide_reactions">隐藏回应</string>
    <string name="hide_reactions_description">隐藏消息下方的回应。</string>
    <string name="hide_reply_previews">隐藏回复预览</string>
    <string name="hide_reply_previews_description">隐藏回复上方引用的消息。</string>
    <string name="hide_shop_entry">隐藏商店</string>
    <string name="hide_shop_entry_description">隐藏个人资料和设置中的商店按钮。</string>
    <string name="hide_theme_activity_previews">隐藏主题中的活动预览</string>
    <string name="hide_theme_activity_previews_description">隐藏外观预览中的活动卡片。</string>
    <string name="better_stream_quality">更好的直播画质</string>
    <string name="better_stream_quality_description">以 Nitro 的分辨率和帧率直播你的屏幕。</string>
    <string name="better_video_quality">更好的视频画质</string>
    <string name="better_video_quality_description">以更高画质上传视频。上传限制保持不变。</string>
    <string name="chat_animation_switch">聊天动画开关</string>
    <string name="chat_animation_switch_description">让 GIF 自动播放开关同时停止聊天中的表情动画。</string>
    <string name="disable_call_idle">停用通话闲置</string>
    <string name="disable_call_idle_description">空的私信通话超过 3 分钟后仍让你留在通话中。</string>
    <string name="quiet_super_reactions">安静的超级回应</string>
    <string name="quiet_super_reactions_description">让超级回应动画不再循环播放。</string>
    <string name="static_chat_emoji">静态聊天表情</string>
    <string name="static_chat_emoji_description">让聊天中的自定义表情不再播放动画。</string>
    <string name="static_chat_gifs">静态聊天 GIF</string>
    <string name="static_chat_gifs_description">让聊天中的 GIF 不再自动播放。</string>
    <string name="static_stickers">静态贴纸</string>
    <string name="static_stickers_description">将贴纸显示为静态图片。</string>
    <string name="freemoji">Freemoji</string>
    <string name="freemoji_description">将锁定的自定义表情作为图片链接发送。</string>
    <string name="local_themes">本地主题</string>
    <string name="local_themes_description">在这部手机上解锁 Nitro 主题。</string>
    <string name="premium_app_icons">高级应用图标</string>
    <string name="premium_app_icons_description">解锁 Nitro 应用图标。</string>
    <string name="sticker_links">贴纸链接</string>
    <string name="sticker_links_description">将锁定的贴纸作为图片链接发送。</string>
    <string name="block_analytics">阻止分析</string>
    <string name="block_analytics_description">阻止 Discord 记录你的操作。</string>
    <string name="block_crash_reports">阻止崩溃报告</string>
    <string name="block_crash_reports_description">阻止 Discord 发送崩溃报告。</string>
    <string name="hide_typing_indicator">隐藏正在输入提示</string>
    <string name="hide_typing_indicator_description">不让他人看到你正在输入。</string>
    <string name="local_read_state">本地已读状态</string>
    <string name="local_read_state_description">只在这部手机上将消息标为已读。</string>
    <string name="keep_patched_bundle">更新后保留补丁</string>
    <string name="keep_patched_bundle_description">防止 Discord 的应用内代码更新移除你的补丁。</string>
</resources>
