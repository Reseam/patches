    <string name="static_stickers">Static stickers</string>
    <string name="static_stickers_description">Shows stickers as still images.</string>
    <string name="freemoji">Freemoji</string>
    <string name="freemoji_description">Sends locked custom emoji as image links.</string>
    <string name="local_themes">Local themes</string>
