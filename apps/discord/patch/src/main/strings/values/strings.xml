    <string name="sticker_links">Sticker links</string>
    <string name="sticker_links_description">Sends locked stickers as image links.</string>
    <string name="block_analytics">Block analytics</string>
    <string name="block_analytics_description">Stops Discord from logging what you do.</string>
    <string name="block_crash_reports">Block crash reports</string>
    <string name="block_crash_reports_description">Stops Discord from sending crash reports.</string>
    <string name="hide_typing_indicator">Hide typing indicator</string>
    <string name="hide_typing_indicator_description">Stops others from seeing that you are typing.</string>
    <string name="local_read_state">Local read state</string>
    <string name="local_read_state_description">Marks messages as read on this phone only.</string>
    <string name="keep_patched_bundle">Keep patches on updates</string>
    <string name="keep_patched_bundle_description">Stops Discord\'s in-app code updates from removing your patches.</string>
