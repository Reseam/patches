<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="custom_themes">Custom themes</string>
    <string name="custom_themes_description">Lets you create, edit, share and use themes, including the Reseam theme.</string>
    <string name="add_source_cards">Add source cards</string>
    <string name="add_source_cards_description">Shows patch source links as cards with an Add to Reseam Manager button.</string>
    <string name="clean_outgoing_links">Clean sent links</string>
    <string name="clean_outgoing_links_description">Removes tracking from links when you send them.</string>
    <string name="colored_names">Colored names</string>
    <string name="colored_names_description">Colors names with their role color in mentions, typing, voice channels and member lists.</string>
    <string name="delete_without_confirmation">Delete without confirmation</string>
    <string name="delete_without_confirmation_description">Deletes your messages from the long-press menu without asking.</string>
    <string name="disable_message_swipes">Disable message swipes</string>
    <string name="disable_message_swipes_description">Stops swipes on messages from starting replies or edits.</string>
    <string name="draft_preview">Draft preview</string>
    <string name="draft_preview_description">Long-press the send button to preview your message before sending it.</string>
    <string name="hide_blocked_messages">Hide blocked messages</string>
    <string name="hide_blocked_messages_description">Hides messages from blocked and ignored users.</string>
