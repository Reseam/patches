    <string name="quiet_super_reactions_description">Stops Super Reaction animations from looping.</string>
    <string name="static_chat_emoji">Static chat emoji</string>
    <string name="static_chat_emoji_description">Stops custom emoji from animating in chat.</string>
    <string name="static_chat_gifs">Static chat GIFs</string>
