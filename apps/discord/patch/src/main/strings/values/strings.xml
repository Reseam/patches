    <string name="chat_animation_switch_description">Makes the GIF autoplay switch also stop emoji animations in chat.</string>
    <string name="disable_call_idle">Disable call idle</string>
    <string name="disable_call_idle_description">Keeps you in empty DM calls after 3 minutes.</string>
