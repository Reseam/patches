<!-- The circle YouTube draws behind the fullscreen button in the bold layout: 36dp, 12dp above the button's bottom.
     The inset also pads the icon up into the circle; the fixed size keeps it round when the row narrows the button. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="12dp">
    <layer-list>
        <item
            android:width="36dp"
            android:height="36dp"
            android:drawable="@drawable/player_button_circle_background"
            android:gravity="center" />
    </layer-list>
</inset>
