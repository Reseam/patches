<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="hide_ads">隐藏广告</string>
    <string name="hide_ads_description">隐藏时间线中的推广帖子和 Google 广告。</string>
    <string name="drawer_entry">Reseam 抽屉入口</string>
    <string name="drawer_entry_description">在抽屉中的“设置和隐私”下添加 Reseam 设置。</string>
    <string name="settings_entry">Reseam 设置入口</string>
    <string name="settings_entry_description">在 X 的“设置和隐私”中添加 Reseam 设置。</string>
    <string name="customize_explore">自定义探索</string>
    <string name="customize_explore_description">隐藏 Grok 故事、趋势和选定的探索标签页。</string>
    <string name="user_feature_switches">功能开关覆盖</string>
    <string name="user_feature_switches_description">将 X 的功能开关设为你选择的值。</string>
    <string name="grok">隐藏 Grok</string>
    <string name="grok_description">隐藏整个应用中的 Grok 标签页和 Grok 按钮。</string>
    <string name="customize_home_tabs">自定义首页标签页</string>
    <string name="customize_home_tabs_description">隐藏“为你推荐”标签页和“添加”标签页。</string>
    <string name="default_to_following">默认打开“正在关注”</string>
    <string name="default_to_following_description">打开“正在关注”并停留在那里。</string>
    <string name="disable_home_tab_swipe">停用首页标签页滑动</string>
    <string name="disable_home_tab_swipe_description">滑动时不再切换首页标签页。</string>
    <string name="hide_live_bar">隐藏直播栏</string>
    <string name="hide_live_bar_description">隐藏首页上方的直播栏，也可以选择隐藏头像上的直播光圈。</string>
    <string name="custom_url_handling">在应用中打开镜像链接</string>
    <string name="custom_url_handling_description">在应用中打开 fixvx.com、vxtwitter.com 等类似链接。</string>
    <string name="open_links">打开完整链接</string>
    <string name="open_links_description">直接打开链接的目标地址，不经过 t.co。</string>
    <string name="open_post_links">打开帖子链接</string>
    <string name="open_post_links_description">直接在帖子中打开帖子链接，而不是在“为你推荐”时间线上方打开。</string>
    <string name="login_transfer">导入和导出登录信息</string>
    <string name="login_transfer_description">将你的登录信息复制到剪贴板，也可以粘贴登录信息来登录。</string>
    <string name="download_button">下载按钮</string>
    <string name="download_button_description">为含有照片、GIF 或视频的帖子添加下载按钮。</string>
    <string name="download_videos">下载视频</string>
    <string name="download_videos_description">以原始文件下载每个视频，不带水印。</string>
    <string name="save_all_media">保存所有媒体</string>
    <string name="save_all_media_description">保存帖子中的一项媒体时，提供保存全部媒体的选项。</string>
    <string name="save_media">保存媒体</string>
    <string name="save_media_description">将照片、视频和 GIF 保存到你选择的文件夹。</string>
    <string name="show_sensitive_media">显示敏感媒体</string>
    <string name="show_sensitive_media_description">显示敏感媒体，不加模糊或警告。</string>
    <string name="customize_navigation_bar">自定义导航栏</string>
    <string name="customize_navigation_bar_description">重新排列、隐藏和替换导航栏中的标签页。</string>
    <string name="hide_drawer_items">隐藏抽屉项目</string>
    <string name="hide_drawer_items_description">隐藏抽屉中选定的行，例如 Premium、Money 和 Spaces。</string>
    <string name="hide_notification_prompts">隐藏通知提示</string>
    <string name="hide_notification_prompts_description">隐藏开启通知的提示。</string>
    <string name="hide_premium_upsells">隐藏 Premium 推销</string>
    <string name="hide_premium_upsells_description">隐藏 Premium 推销、“获取认证”提示和启动时的付费墙。</string>
    <string name="hide_promotion_prompts">隐藏推广提示</string>
    <string name="hide_promotion_prompts_description">隐藏你帖子上的“加热”和“推广”提示。</string>
    <string name="unlock_premium">解锁 Premium</string>
    <string name="unlock_premium_description">解锁应用自行检查的 Premium 选项，例如应用图标和颜色。</string>
    <string name="privacy">阻止广告跟踪</string>
    <string name="privacy_description">停止报告已安装的应用，并关闭广告跟踪。</string>
    <string name="customize_profile_tabs">自定义个人资料标签页</string>
    <string name="customize_profile_tabs_description">隐藏选定的个人资料标签页，例如“精选”和“喜欢”。</string>
    <string name="default_media_tab">默认媒体标签页</string>
    <string name="default_media_tab_description">让个人资料的“媒体”标签页在“照片”或“视频”上打开。</string>
    <string name="share_links">清理分享链接</string>
    <string name="share_links_description">移除你分享的链接中的跟踪参数，并可通过便于嵌入的域名分享帖子。</string>
    <string name="themes">主题</string>
    <string name="themes_description">恢复“暗淡”主题和 Twitter 品牌，并添加强调色。</string>
    <string name="themes_twitter_app_identity">Twitter 应用名称和图标</string>
    <string name="themes_twitter_app_identity_description">在应用信息和通知中，将应用命名为 Twitter 并使用小鸟图标。</string>
    <string name="default_reply_sort">默认回复排序</string>
    <string name="default_reply_sort_description">按你选择的方式排序回复。</string>
    <string name="hide_compose_button">隐藏发帖按钮</string>
    <string name="hide_compose_button_description">隐藏悬浮的发帖按钮。</string>
    <string name="hide_new_posts_banner">隐藏新帖子横幅</string>
    <string name="hide_new_posts_banner_description">隐藏时间线顶部的新帖子横幅。</string>
    <string name="hide_post_metrics">隐藏帖子数据</string>
    <string name="hide_post_metrics_description">隐藏帖子上的数字。按钮仍可正常使用。</string>
    <string name="hide_recommendations">隐藏推荐</string>
    <string name="hide_recommendations_description">隐藏“推荐关注”、“订阅”和“可加入的社群”。</string>
    <string name="show_poll_results">显示投票结果</string>
    <string name="show_poll_results_description">在你投票前就显示投票结果。</string>
    <string name="show_withheld_posts">显示被限制的帖子</string>
    <string name="show_withheld_posts_description">显示在你所在国家/地区被限制的帖子和个人资料。</string>
    <string name="translate_posts">翻译帖子</string>
    <string name="translate_posts_description">可以选择由谁翻译帖子，或关闭翻译。</string>
</resources>
