<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="hide_ads">隱藏廣告</string>
    <string name="hide_ads_description">隱藏時間軸中的推廣貼文和 Google 廣告。</string>
    <string name="drawer_entry">Reseam 側邊選單入口</string>
    <string name="drawer_entry_description">在側邊選單的「設定和隱私」下方新增 Reseam 設定。</string>
    <string name="settings_entry">Reseam 設定入口</string>
    <string name="settings_entry_description">在 X 的「設定和隱私」中新增 Reseam 設定。</string>
    <string name="customize_explore">自訂探索</string>
    <string name="customize_explore_description">隱藏 Grok 新聞、趨勢和選取的探索分頁。</string>
    <string name="user_feature_switches">功能旗標覆寫</string>
    <string name="user_feature_switches_description">將 X 的功能開關設為你選擇的值。</string>
    <string name="grok">隱藏 Grok</string>
    <string name="grok_description">隱藏整個應用程式中的 Grok 分頁和 Grok 按鈕。</string>
    <string name="customize_home_tabs">自訂首頁分頁</string>
    <string name="customize_home_tabs_description">隱藏「為你推薦」分頁和「新增」分頁。</string>
    <string name="default_to_following">預設開啟「跟隨中」</string>
    <string name="default_to_following_description">開啟「跟隨中」並停留在那裡。</string>
    <string name="disable_home_tab_swipe">停用首頁分頁滑動</string>
    <string name="disable_home_tab_swipe_description">滑動時不再切換首頁分頁。</string>
    <string name="hide_live_bar">隱藏直播列</string>
    <string name="hide_live_bar_description">隱藏首頁上方的直播列，也可選擇隱藏頭像上的直播光環。</string>
    <string name="custom_url_handling">在應用程式中開啟鏡像連結</string>
    <string name="custom_url_handling_description">在應用程式中開啟 fixvx.com、vxtwitter.com 和類似連結。</string>
    <string name="open_links">開啟完整連結</string>
    <string name="open_links_description">直接開啟連結的目的地，不經過 t.co。</string>
    <string name="open_post_links">開啟貼文連結</string>
    <string name="open_post_links_description">直接在貼文中開啟貼文連結，而不是在「為你推薦」時間軸上方開啟。</string>
    <string name="login_transfer">匯入和匯出登入資訊</string>
    <string name="login_transfer_description">將你的登入資訊複製到剪貼簿，也可以貼上登入資訊來登入。</string>
    <string name="download_button">下載按鈕</string>
    <string name="download_button_description">為含有相片、GIF 或影片的貼文新增下載按鈕。</string>
    <string name="download_videos">下載影片</string>
    <string name="download_videos_description">以原始檔案下載每部影片，不含浮水印。</string>
    <string name="save_all_media">儲存所有媒體</string>
    <string name="save_all_media_description">儲存貼文中的一項媒體時，提供儲存全部媒體的選項。</string>
    <string name="save_media">儲存媒體</string>
    <string name="save_media_description">將相片、影片和 GIF 儲存到你選擇的資料夾。</string>
    <string name="show_sensitive_media">顯示敏感媒體</string>
    <string name="show_sensitive_media_description">顯示敏感媒體，不加模糊或警告。</string>
    <string name="customize_navigation_bar">自訂導覽列</string>
    <string name="customize_navigation_bar_description">重新排列、隱藏和取代導覽列的分頁。</string>
    <string name="hide_drawer_items">隱藏側邊選單項目</string>
    <string name="hide_drawer_items_description">隱藏側邊選單中選取的項目，例如 Premium、Money 和語音空間。</string>
    <string name="hide_notification_prompts">隱藏通知提示</string>
    <string name="hide_notification_prompts_description">隱藏開啟通知的提示。</string>
    <string name="hide_premium_upsells">隱藏 Premium 推銷</string>
    <string name="hide_premium_upsells_description">隱藏 Premium 推銷、「取得驗證」提示和啟動時的付費牆。</string>
    <string name="hide_promotion_prompts">隱藏推廣提示</string>
    <string name="hide_promotion_prompts_description">隱藏你貼文上的「加強推廣」和「推廣」提示。</string>
    <string name="unlock_premium">解鎖 Premium</string>
    <string name="unlock_premium_description">解鎖應用程式自行檢查的 Premium 選項，例如應用程式圖示和顏色。</string>
    <string name="privacy">封鎖廣告追蹤</string>
    <string name="privacy_description">停止回報已安裝的應用程式，並關閉廣告追蹤。</string>
    <string name="customize_profile_tabs">自訂個人檔案分頁</string>
    <string name="customize_profile_tabs_description">隱藏選取的個人檔案分頁，例如「精選」和「喜歡」。</string>
    <string name="default_media_tab">預設媒體分頁</string>
    <string name="default_media_tab_description">讓個人檔案的「媒體」分頁在「相片」或「影片」開啟。</string>
    <string name="share_links">清理分享連結</string>
    <string name="share_links_description">移除你分享的連結中的追蹤參數，並可透過方便嵌入的網域分享貼文。</string>
    <string name="themes">主題</string>
    <string name="themes_description">恢復「昏暗」主題和 Twitter 品牌，並新增強調色。</string>
    <string name="themes_twitter_app_identity">Twitter 應用程式名稱和圖示</string>
    <string name="themes_twitter_app_identity_description">在應用程式資訊和通知中，將應用程式命名為 Twitter 並使用小鳥圖示。</string>
    <string name="default_reply_sort">預設回覆排序</string>
    <string name="default_reply_sort_description">依你選擇的方式排序回覆。</string>
    <string name="hide_compose_button">隱藏撰寫按鈕</string>
    <string name="hide_compose_button_description">隱藏浮動的撰寫按鈕。</string>
    <string name="hide_new_posts_banner">隱藏新貼文橫幅</string>
    <string name="hide_new_posts_banner_description">隱藏時間軸頂端的新貼文橫幅。</string>
    <string name="hide_post_metrics">隱藏貼文數據</string>
    <string name="hide_post_metrics_description">隱藏貼文上的數字。按鈕仍可正常使用。</string>
    <string name="hide_recommendations">隱藏推薦</string>
    <string name="hide_recommendations_description">隱藏「推薦跟隨」、「訂閱」和「可加入的社群」。</string>
    <string name="show_poll_results">顯示投票結果</string>
    <string name="show_poll_results_description">在你投票前就顯示投票結果。</string>
    <string name="show_withheld_posts">顯示受限制的貼文</string>
    <string name="show_withheld_posts_description">顯示在你所在國家/地區受限制的貼文和個人檔案。</string>
    <string name="translate_posts">翻譯貼文</string>
    <string name="translate_posts_description">可以選擇由誰翻譯貼文，或關閉翻譯。</string>
</resources>
